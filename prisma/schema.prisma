  @@map("compliance_items")
}

enum ComplianceRegisterType {
  BRPD // Building Regulations Principal Designer
  CDM // Construction Design Management
  BUILDING_REGS // Building regulations/technical requirements
  FIRE_SAFETY // Fire and life safety
  EDGE // EDGE sustainability
  BREEAM // BREEAM sustainability
  LEED // LEED sustainability
  CUSTOM
}

enum ComplianceItemStatus {
  NOT_APPLICABLE
  NOT_STARTED
  IN_PROGRESS
  EVIDENCE_SUBMITTED
  UNDER_REVIEW
  COMPLIANT
  NON_COMPLIANT
  ACTION_REQUIRED
  APPROVED_WITH_CONDITION
  CLOSED
}

