// PDR — Onboarding Templates
// ═══════════════════════════════════════════════════════════

model OnboardingTemplate {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String // e.g. "Architect Onboarding", "Intern Onboarding"
  roleLevel      String?  @map("role_level") // Which role this template targets
  description    String?
  isDefault      Boolean  @default(false) @map("is_default")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organisation Organisation             @relation(fields: [organisationId], references: [id])
  items        OnboardingTemplateItem[]
  assignments  OnboardingAssignment[]

  @@map("onboarding_templates")
}

model OnboardingTemplateItem {
  id               String   @id @default(cuid())
  templateId       String   @map("template_id")
  stage            String // BEFORE_START, DAY_ONE, ROLE_SPECIFIC, PROBATION
  category         String? // e.g. "IT Setup", "Health & Safety", "Project Orientation"
  title            String
  description      String?
  responsibleRole  String?  @map("responsible_role") // HR, MANAGER, IT, EMPLOYEE
  daysFromStart    Int      @default(0) @map("days_from_start") // Offset from employee start date
  requiresEvidence        Boolean   @default(false) @map("requires_evidence")
  requiresApproval        Boolean   @default(false) @map("requires_approval")
  notifyEmployee          Boolean   @default(false) @map("notify_employee")
  actionRequired          Boolean   @default(false) @map("action_required")
  acknowledgementRequired Boolean   @default(false) @map("acknowledgement_required")
  dueDate                 DateTime? @map("due_date")
  sortOrder               Int       @default(0) @map("sort_order")
  createdAt               DateTime  @default(now()) @map("created_at")

  template OnboardingTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  tasks    OnboardingTask[]

  @@map("onboarding_template_items")
}

model OnboardingAssignment {
  id             String    @id @default(cuid())
  templateId     String    @map("template_id")
  profileId      String    @map("profile_id")
  organisationId String    @map("organisation_id")
  assignedById   String    @map("assigned_by_id")
  startDate      DateTime  @map("start_date")
  status         String    @default("ACTIVE") // ACTIVE, COMPLETED, CANCELLED
  completedAt    DateTime? @map("completed_at")
  progress       Float     @default(0) // 0-100 percentage
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  template OnboardingTemplate @relation(fields: [templateId], references: [id])

  tasks OnboardingTask[]

  @@unique([templateId, profileId])
  @@map("onboarding_assignments")
}

model OnboardingTask {
  id                      String    @id @default(cuid())
  assignmentId            String    @map("assignment_id")
  templateItemId          String    @map("template_item_id")
  assigneeId              String?   @map("assignee_id") // Who should complete this task
  title                   String
  stage                   String // BEFORE_START, DAY_ONE, ROLE_SPECIFIC, PROBATION
  category                String?
  dueDate                 DateTime? @map("due_date")
  status                  String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, OVERDUE, WAIVED
  completedAt             DateTime? @map("completed_at")
  completedById           String?   @map("completed_by_id")
  evidenceUrl             String?   @map("evidence_url")
  evidenceNote            String?   @map("evidence_note")
  approvedById            String?   @map("approved_by_id")
  approvedAt              DateTime? @map("approved_at")
  notifyEmployee          Boolean   @default(false) @map("notify_employee")
  actionRequired          Boolean   @default(false) @map("action_required")
  acknowledgementRequired Boolean   @default(false) @map("acknowledgement_required")
  comment                 String?
  sortOrder               Int       @default(0) @map("sort_order")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  assignment   OnboardingAssignment   @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  templateItem OnboardingTemplateItem @relation(fields: [templateItemId], references: [id])

  @@map("onboarding_tasks")
}

// ═══════════════════════════════════════════════════════════
// PDR — Project Milestones and Updates
// ═══════════════════════════════════════════════════════════

model ProjectMilestone {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  title         String
  description   String?
  category      String? // DESIGN_FREEZE, PLANNING, CONSTRUCTION, OPERATOR_REVIEW, STAGE_GATE, HANDOVER, CUSTOM
  dueDate       DateTime  @map("due_date")
  completedDate DateTime? @map("completed_date")
  status        String    @default("UPCOMING") // UPCOMING, DUE, OVERDUE, COMPLETED, CANCELLED
  ownerId       String?   @map("owner_id")
  stage         String? // Which project stage this milestone belongs to
  sortOrder     Int       @default(0) @map("sort_order")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@map("project_milestones")
}

model ProjectUpdate {
  id             String   @id @default(cuid())
  projectId      String   @map("project_id")
  authorId       String   @map("author_id")
  weekEnding     DateTime @map("week_ending")
  progress       String? // What was done this week
  issues         String? // Current blockers
  decisions      String? // Decisions made or needed
  actions        String? // Actions assigned
  healthOverride String?  @map("health_override") // GREEN, AMBER, RED — manual override
  healthReason   String?  @map("health_reason") // Reason for override
  attachments    String? // JSON array of file URLs
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_updates")
}

// ═══════════════════════════════════════════════════════════
// PDR — Project Health History and Overrides
// ═══════════════════════════════════════════════════════════

model ProjectHealthRecord {
  id                String    @id @default(cuid())
  projectId         String    @map("project_id")
  category          String // PROGRAMME, TASKS, PLANNING, COMPLIANCE, COMMERCIAL, RESOURCING, OVERALL
  rating            String // GREEN, AMBER, RED, GREY
  score             Float? // 0-100 numeric score
  reason            String? // Why this rating
  sourceRecords     String?   @map("source_records") // JSON: links to source data
  responsibleId     String?   @map("responsible_id")
  recommendedAction String?   @map("recommended_action")
  isOverride        Boolean   @default(false) @map("is_override")
  overrideById      String?   @map("override_by_id")
  overrideExpiry    DateTime? @map("override_expiry")
  calculatedAt      DateTime  @default(now()) @map("calculated_at")

  @@index([projectId, category, calculatedAt])
  @@map("project_health_records")
}

// ═══════════════════════════════════════════════════════════
// PDR — Key Metrics
// ═══════════════════════════════════════════════════════════

model KeyMetric {
  id              String   @id @default(cuid())
  projectId       String   @map("project_id")
  name            String // Metric name
  category        String // GENERAL, HOSPITALITY, SUSTAINABILITY, CUSTOM
  value           String? // Current value (stored as string for flexibility)
  unit            String? // m², keys, %, £, etc.
  targetValue     String?  @map("target_value")
  status          String? // ON_TARGET, ABOVE, BELOW, NOT_SET
  lastUpdatedById String?  @map("last_updated_by_id")
  notes           String?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("key_metrics")
}

// ═══════════════════════════════════════════════════════════
// PDR — Schedule of Accommodation
// ═══════════════════════════════════════════════════════════

model SOAVersion {
  id            String    @id @default(cuid())
  projectId     String    @map("project_id")
  versionNumber Int       @map("version_number")
  name          String? // e.g. "Stage 2 Issue", "Operator Review Rev A"
  status        String    @default("DRAFT") // DRAFT, UNDER_REVIEW, APPROVED, SUPERSEDED
  approvedById  String?   @map("approved_by_id")
  approvedAt    DateTime? @map("approved_at")
  changeReason  String?   @map("change_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  project Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  rows    SOARow[]

  @@unique([projectId, versionNumber])
  @@map("soa_versions")
}

model SOARow {
  id                String    @id @default(cuid())
  versionId         String    @map("version_id")
  spaceCategory     String    @map("space_category") // GUEST_ACCOMMODATION, FOH, BOH, CIRCULATION, EXTERNAL
  roomType          String    @map("room_type") // e.g. "Standard Room", "Reception", "Main Kitchen"
  code              String? // e.g. "STD-01", "REC-01"
  quantity          Int       @default(1)
  targetArea        Float?    @map("target_area") // m²
  currentArea       Float?    @map("current_area") // m²
  requirement       String? // Source requirement: CLIENT_BRIEF, OPERATOR, STANDARD, ACCESSIBILITY, CWA, CUSTOM
  requirementSource String?   @map("requirement_source") // Name/version of the source document
  status            String    @default("DRAFT") // DRAFT, REVIEWED, APPROVED, QUERY
  ownerId           String?   @map("owner_id")
  comment           String?
  reviewDate        DateTime? @map("review_date")
  approvalDate      DateTime? @map("approval_date")
  sortOrder         Int       @default(0) @map("sort_order")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  version SOAVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@map("soa_rows")
}

// ── Approval Workflow Engine ─────────────────────────────────

enum ApprovalRequestType {
  LEAVE
  EXPENSE
  SERVICE_REQUEST
  TRAVEL
}

enum ApproverType {
  LINE_MANAGER
  PROJECT_MANAGER
  ROLE
  SPECIFIC_PERSON
}

enum ApprovalStepStatus {
  PENDING
  APPROVED
  REJECTED
  SKIPPED
  ESCALATED
}

/// Template defining an approval workflow for a given request type.
/// Organisations can have multiple routes per type with conditions (e.g. amount thresholds).
model ApprovalRoute {
  id               String              @id @default(cuid())
  organisationId   String              @map("organisation_id")
  requestType      ApprovalRequestType @map("request_type")
  name             String // e.g. "Standard Leave", "Large Expense (>£5k)"
  isDefault        Boolean             @default(false) @map("is_default")
  isActive         Boolean             @default(true) @map("is_active")
  priority         Int                 @default(0) // Higher = checked first
  conditions       Json?               // e.g. { "minAmount": 5000, "department": "Design" }
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  organisation Organisation    @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  steps        ApprovalRouteStep[]
  instances    ApprovalInstance[]

  @@index([organisationId, requestType])
  @@map("approval_routes")
}

/// A step within an approval route template.
/// Steps execute in stepOrder; each step must be approved before advancing.
model ApprovalRouteStep {
  id                     String       @id @default(cuid())
  routeId                String       @map("route_id")
  stepOrder              Int          @map("step_order")
  label                  String       @default("") // e.g. "Line Manager Review"
  approverType           ApproverType @map("approver_type")
  approverRole           String?      @map("approver_role") // OrgPermission value if approverType=ROLE
  approverId             String?      @map("approver_id") // Profile ID if approverType=SPECIFIC_PERSON
  canSkipIfSameAsPrevious Boolean     @default(false) @map("can_skip_if_same_as_previous")
  escalationDays         Int?         @map("escalation_days") // Auto-escalate after N days

  route ApprovalRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, stepOrder])
  @@map("approval_route_steps")
}

/// An active approval workflow instance for a specific entity (expense, leave request, etc).
model ApprovalInstance {
  id               String              @id @default(cuid())
  organisationId   String              @map("organisation_id")
  routeId          String              @map("route_id")
  requestType      ApprovalRequestType @map("request_type")
  entityId         String              @map("entity_id") // FK to the entity being approved
  submitterId      String              @map("submitter_id")
  currentStepOrder Int                 @default(1) @map("current_step_order")
  status           String              @default("IN_PROGRESS") // IN_PROGRESS, APPROVED, REJECTED, CANCELLED
  completedAt      DateTime?           @map("completed_at")
  createdAt        DateTime            @default(now()) @map("created_at")
  updatedAt        DateTime            @updatedAt @map("updated_at")

  organisation Organisation          @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  route        ApprovalRoute          @relation(fields: [routeId], references: [id])
  submitter    Profile                @relation("ApprovalSubmitter", fields: [submitterId], references: [id])
  steps        ApprovalStepInstance[]

  @@index([organisationId, status])
  @@index([entityId, requestType])
  @@index([submitterId])
  @@map("approval_instances")
}

/// An individual step instance within an active approval workflow.
model ApprovalStepInstance {
  id                String             @id @default(cuid())
  instanceId        String             @map("instance_id")
  stepOrder         Int                @map("step_order")
  label             String             @default("")
  approverId        String?            @map("approver_id") // Resolved approver Profile ID
  status            ApprovalStepStatus @default(PENDING)
  comment           String?
  actionedAt        DateTime?          @map("actioned_at")
  escalationDueAt   DateTime?          @map("escalation_due_at")
  escalatedToId     String?            @map("escalated_to_id") // If escalated, who got it
  createdAt         DateTime           @default(now()) @map("created_at")

  instance    ApprovalInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)
  approver    Profile?         @relation("ApprovalStepApprover", fields: [approverId], references: [id])
  escalatedTo Profile?         @relation("ApprovalStepEscalatedTo", fields: [escalatedToId], references: [id])

  @@unique([instanceId, stepOrder])
  @@map("approval_step_instances")
}

// ═══════════════════════════════════════════════════════════
// EXTERNAL LINKS — Unified SharePoint / URL layer
// ═══════════════════════════════════════════════════════════

model ExternalLink {
  id             String           @id @default(cuid())
  organisationId String           @map("organisation_id")
  entityType     String           @map("entity_type") // e.g. "project", "task", "expense", "document"
  entityId       String           @map("entity_id")
  linkType       ExternalLinkType @default(EXTERNAL_URL) @map("link_type")
  url            String
  label          String
  createdById    String           @map("created_by_id")
  createdAt      DateTime         @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdBy    Profile      @relation("ExternalLinkCreator", fields: [createdById], references: [id])

  @@index([entityType, entityId])
  @@index([organisationId])
  @@map("external_links")
}

enum ExternalLinkType {
  SHAREPOINT_FOLDER
  SHAREPOINT_DOCUMENT
  EXTERNAL_URL
}
