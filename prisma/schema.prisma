// Coordin.io — CWA Homes Operating System
// Full data model covering all sprints
// Sprint 1: Identity, Invitation, Activation, Audit
// Sprint 2: Onboarding, Policies, Training
// Sprint 3: Dashboard, Projects, Documents
// Sprint 4: Tasks, Checklists, Review Workflow
// Sprint 5: CPD, Requests, Leave, Equipment
// Sprint 6: Mobile Site, Snagging, Offline

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════
// PLATFORM — Super Admin
// ═══════════════════════════════════════════════════════════

model PlatformAdmin {
  id         String   @id @default(dbgenerated("(gen_random_uuid())::text"))
  authUserId String   @map("auth_user_id")
  email      String
  name       String
  grantedAt  DateTime @default(now()) @map("granted_at") @db.Timestamp(6)
  grantedBy  String?  @map("granted_by")

  @@map("platform_admins")
}

// ═══════════════════════════════════════════════════════════
// SPRINT 1 — Identity, Invitation & Activation
// ═══════════════════════════════════════════════════════════

enum Currency {
  NGN // Nigerian Naira
  GBP // British Pounds
  USD // US Dollars
  EUR // Euros
}

model Organisation {
  id              String     @id @default(cuid())
  name            String
  slug            String     @unique
  logoUrl         String?    @map("logo_url")
  defaultCurrency Currency   @default(NGN) @map("default_currency")
  currencies      Currency[] // All currencies this org uses
  // Org-level settings: regional, numbering templates, etc.
  settings        Json?      @default("{}") @map("settings")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  offices             Office[]
  publicHolidays      PublicHoliday[]
  blackoutDates       BlackoutDate[]
  profiles            Profile[]
  projects            Project[]
  invitations         Invitation[]
  roles               CorporateRole[]
  policies            PolicyDocument[]
  assets              Asset[]
  auditEvents         AuditEvent[]
  serviceRequests     ServiceRequest[]
  hrDocuments         HRDocument[]
  onboardingTemplates OnboardingTemplate[]
  feeQuotes           FeeQuote[]
  approvalRoutes      ApprovalRoute[]
  approvalInstances   ApprovalInstance[]
  externalLinks       ExternalLink[]

  @@map("organisations")
}

model Office {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String
  city           String
  country        String   @default("NG")
  isHeadOffice   Boolean  @default(false) @map("is_head_office")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation    Organisation     @relation(fields: [organisationId], references: [id])
  profiles        Profile[]
  projects        Project[]
  serviceRequests ServiceRequest[] @relation("ServiceRequestOffice")
  publicHolidays  PublicHoliday[]

  @@map("offices")
}

model PublicHoliday {
  id             String      @id @default(cuid())
  organisationId String      @map("organisation_id")
  officeId       String?     @map("office_id") // null = applies to all offices
  name           String
  date           DateTime
  isRecurring    Boolean     @default(false) @map("is_recurring") // repeats annually
  country        String      @default("GB")
  type           HolidayType @default(PUBLIC_HOLIDAY)
  createdAt      DateTime    @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  office       Office?      @relation(fields: [officeId], references: [id])

  @@index([organisationId, date])
  @@map("public_holidays")
}

enum HolidayType {
  PUBLIC_HOLIDAY
  BLACKOUT_DATE
  COMPANY_CLOSURE
}

model BlackoutDate {
  id             String   @id @default(cuid())
  organisationId String   @map("organisation_id")
  name           String   // e.g. "Year-end close", "Audit week"
  startDate      DateTime @map("start_date")
  endDate        DateTime @map("end_date")
  reason         String?  // optional extended description
  createdById    String?  @map("created_by_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdBy    Profile?     @relation("BlackoutDateCreatedBy", fields: [createdById], references: [id])

  @@index([organisationId, startDate])
  @@map("blackout_dates")
}

model CorporateRole {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  name           String // e.g. "Graduate Architectural Assistant", "Design Lead"
  level          RoleLevel @default(STAFF)
  createdAt      DateTime  @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  profiles     Profile[]

  @@unique([organisationId, name])
  @@map("corporate_roles")
}

enum RoleLevel {
  ADMIN
  SENIOR_MANAGEMENT
  MANAGEMENT
  SENIOR_STAFF
  STAFF
  EXTERNAL
}

/// Profile — linked to Supabase auth.users via authUserId
model Profile {
  id             String  @id @default(cuid())
  authUserId     String? @unique @map("auth_user_id") // Supabase auth.users.id
  organisationId String  @map("organisation_id")
  officeId       String? @map("office_id")
  roleId         String? @map("role_id")

  fullName  String  @map("full_name")
  email     String
  jobTitle  String? @map("job_title")
  phone     String?
  avatarUrl String? @map("avatar_url")

  // Org-level permission
  orgPermission OrgPermission @default(MEMBER)

  // Manager / line manager
  managerId String? @map("manager_id")

  department String? // Direct department field for profile

  // Employment
  startDate     DateTime?     @map("start_date")
  status        ProfileStatus @default(INVITED)
  deactivatedAt DateTime?     @map("deactivated_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  organisation  Organisation   @relation(fields: [organisationId], references: [id])
  office        Office?        @relation(fields: [officeId], references: [id])
  corporateRole CorporateRole? @relation(fields: [roleId], references: [id])
  manager       Profile?       @relation("ManagerReports", fields: [managerId], references: [id])
  reports       Profile[]      @relation("ManagerReports")

  // Employee details
  employeeProfile EmployeeProfile?

  // Invitations created by this user
  invitationsSent    Invitation[] @relation("InvitationCreator")
  invitationReceived Invitation?  @relation("InvitationRecipient")

  // Project memberships
  projectMemberships ProjectMembership[]

  // Tasks
  tasksOwned             Task[]              @relation("TaskOwner")
  tasksReviewing         Task[]              @relation("TaskReviewer")
  taskComments           TaskComment[]
  checklistAssignments   TaskChecklistItem[] @relation("ChecklistAssignee")

  // Documents
  documentsAuthored DocumentRevision[] @relation("DocAuthor")
  documentsReviewed DocumentReview[]

  // Policy acknowledgements
  policyAcks PolicyAcknowledgement[]

  // Training
  trainingCompletions TrainingCompletion[]

  // CPD
  cpdRecords  CPDRecord[] @relation("CPDOwner")
  cpdVerified CPDRecord[] @relation("CPDVerifier")

  // Supervision
  supervisionAsEmployee SupervisionRecord[] @relation("SupervisedEmployee")
  supervisionAsManager  SupervisionRecord[] @relation("Supervisor")

  // Requests
  requestsSubmitted ServiceRequest[] @relation("RequestSubmitter")
  requestsApproved  ServiceRequest[] @relation("RequestApprover")
  requestsAssigned  ServiceRequest[] @relation("RequestAssignee")

  // Leave
  leaveBalances  LeaveBalance[]
  leaveRequests  LeaveRequest[] @relation("LeaveRequester")
  leaveApprovals LeaveRequest[] @relation("LeaveApprover")

  // Expenses
  expenseClaims    ExpenseClaim[] @relation("ExpenseClaimant")
  expenseApprovals ExpenseClaim[] @relation("ExpenseApprover")

  // Assets
  assetAssignments AssetAssignment[]

  // Site
  siteObservations     SiteObservation[]
  observationsAssigned SiteObservation[] @relation("ObservationAssignee")
  snags                Snag[]            @relation("SnagCreator")
  snagVerifications    Snag[]            @relation("SnagVerifier")
  snagsAssigned        Snag[]            @relation("SnagAssignee")

  // Notifications
  notifications Notification[]

  // Audit
  auditEvents AuditEvent[]

  // S21 — Staffing
  resourceAllocations ResourceAllocation[]
  hrDocuments         HRDocument[]
  probationReviews    ProbationReview[]

  // S27 — Timesheets
  timesheetWeeks TimesheetWeek[]

  // Fee Quotes
  feeQuotesCreated FeeQuote[] @relation("feeQuotesCreated")

  // Approval Engine
  approvalSubmissions        ApprovalInstance[]     @relation("ApprovalSubmitter")
  approvalStepsAsApprover    ApprovalStepInstance[] @relation("ApprovalStepApprover")
  approvalStepsEscalatedTo   ApprovalStepInstance[] @relation("ApprovalStepEscalatedTo")
  externalLinksCreated       ExternalLink[]         @relation("ExternalLinkCreator")
  blackoutDatesCreated       BlackoutDate[]         @relation("BlackoutDateCreatedBy")

  // Notification preferences — JSON blob: { "task.assigned": { email: true, inApp: true }, ... }
  notificationPreferences Json? @default("{}") @map("notification_preferences")

  @@map("profiles")
}

enum OrgPermission {
  OWNER
  ADMIN
  HR
  LEGAL
  FINANCE
  COMMERCIAL
  MANAGER
  MEMBER
  VIEWER
}

enum ProfileStatus {
  INVITED
  ACTIVE
  ONBOARDING
  DEACTIVATED
}

model EmployeeProfile {
  id                String  @id @default(cuid())
  profileId         String  @unique @map("profile_id")
  emergencyName     String? @map("emergency_name")
  emergencyPhone    String? @map("emergency_phone")
  emergencyRelation String? @map("emergency_relation")

  // Onboarding
  onboardingComplete    Boolean   @default(false) @map("onboarding_complete")
  onboardingCompletedAt DateTime? @map("onboarding_completed_at")

  // Equipment
  equipmentConfirmed Boolean @default(false) @map("equipment_confirmed")

  // Development
  mentorId             String? @map("mentor_id")
  qualificationPathway String? @map("qualification_pathway") // Part 2, Part 3, etc.

  // Leave
  annualLeaveAllocation Float @default(25) @map("annual_leave_allocation")

  // Employment details — PDR S3
  department          String?   @map("department")
  employmentType      String?   @map("employment_type") // FULL_TIME, PART_TIME, FIXED_TERM, CONTRACTOR, INTERN
  contractType        String?   @map("contract_type") // PERMANENT, TEMPORARY, AGENCY, SECONDMENT
  salary              Float?
  salaryFrequency     String?   @map("salary_frequency") // ANNUAL, MONTHLY, DAILY, HOURLY
  salaryCurrency      String?   @map("salary_currency")
  benefits            String? // JSON text of benefits list
  hmoProvider         String?   @map("hmo_provider")
  hmoPlan             String?   @map("hmo_plan")
  dependants          Int?      @default(0)
  pensionProvider     String?   @map("pension_provider")
  pensionContribution Float?    @map("pension_contribution") // percentage
  workingPattern      String?   @map("working_pattern") // FULL_WEEK, PART_WEEK, COMPRESSED, FLEXIBLE
  workingHours        Float?    @map("working_hours") // hours per week
  noticePeriod        String?   @map("notice_period") // e.g. "1 month", "3 months"
  probationLength     Int?      @map("probation_length") // length in months
  probationStatus     String?   @map("probation_status") // PROBATION, CONFIRMED, EXTENDED, COMPLETED
  probationStartDate  DateTime? @map("probation_start_date")
  probationEndDate    DateTime? @map("probation_end_date")
  availabilityStatus  String?   @map("availability_status") // AVAILABLE, ON_LEAVE, ON_SITE, UNAVAILABLE
  grade               String?   // Staff grade: Senior Management, Management, Senior Staff, Staff, etc.

  // Leave policy override — if set, this employee uses this specific policy instead of grade/default
  leavePolicyId       String?   @map("leave_policy_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  profile Profile @relation(fields: [profileId], references: [id])

  @@map("employee_profiles")
}

model Invitation {
  id             String    @id @default(cuid())
  organisationId String    @map("organisation_id")
  token          String    @unique // Generated via crypto.randomBytes — NOT cuid
  email          String
  fullName       String    @map("full_name")
  jobTitle       String?   @map("job_title")
  officeId       String?   @map("office_id")
  roleId         String?   @map("role_id")
  managerId      String?   @map("manager_id")
  startDate      DateTime? @map("start_date")
  annualLeave    Float?        @map("annual_leave")
  orgPermission  OrgPermission @default(MEMBER) @map("org_permission")

  // Invitation state
  status       InvitationStatus @default(PENDING)
  expiresAt    DateTime         @map("expires_at")
  sentAt       DateTime?        @map("sent_at")
  activatedAt  DateTime?        @map("activated_at")
  revokedAt    DateTime?        @map("revoked_at")
  activationIp String?          @map("activation_ip")

  // Who created / who receives
  createdById String  @map("created_by_id")
  profileId   String? @unique @map("profile_id") // created on activation

  createdAt DateTime @default(now()) @map("created_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  createdBy    Profile      @relation("InvitationCreator", fields: [createdById], references: [id])
  profile      Profile?     @relation("InvitationRecipient", fields: [profileId], references: [id])

  @@map("invitations")
}

enum InvitationStatus {
  PENDING
  SENT
  ACTIVATED
  EXPIRED
  REVOKED
}

// ═══════════════════════════════════════════════════════════
// SPRINT 2 — Onboarding, Policies & Training
// ═══════════════════════════════════════════════════════════

model PolicyDocument {
  id             String         @id @default(cuid())
  organisationId String         @map("organisation_id")
  title          String
  revision       String         @default("1.0")
  category       PolicyCategory @default(GENERAL)
  mandatory      Boolean        @default(true)
  effectiveDate  DateTime       @map("effective_date")
  fileUrl        String?        @map("file_url")
  content        String? // Rich text content
  requiresReack  Boolean        @default(false) @map("requires_reack") // Re-acknowledgement on revision
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  organisation     Organisation            @relation(fields: [organisationId], references: [id])
  acknowledgements PolicyAcknowledgement[]

  @@map("policy_documents")
}

enum PolicyCategory {
  GENERAL
  HR
  IT_DATA_PROTECTION
  HEALTH_SAFETY
  ESMS
  DRAWING_CONTROL
}

model PolicyAcknowledgement {
  id             String    @id @default(cuid())
  profileId      String    @map("profile_id")
  policyId       String    @map("policy_id")
  policyRevision String    @map("policy_revision")
  openedAt       DateTime? @map("opened_at")
  acknowledgedAt DateTime? @map("acknowledged_at")
  acknowledged   Boolean   @default(false)
  quizScore      Float?    @map("quiz_score")
  createdAt      DateTime  @default(now()) @map("created_at")

  profile Profile        @relation(fields: [profileId], references: [id])
  policy  PolicyDocument @relation(fields: [policyId], references: [id])

  @@unique([profileId, policyId, policyRevision])
  @@map("policy_acknowledgements")
}

model TrainingItem {
  id              String   @id @default(cuid())
  title           String
  description     String?
  mandatory       Boolean  @default(false)
  durationMinutes Int?     @map("duration_minutes")
  contentUrl      String?  @map("content_url")
  createdAt       DateTime @default(now()) @map("created_at")

  completions TrainingCompletion[]

  @@map("training_items")
}

model TrainingCompletion {
  id             String    @id @default(cuid())
  profileId      String    @map("profile_id")
  trainingId     String    @map("training_id")
  completedAt    DateTime? @map("completed_at")
  score          Float?
  certificateUrl String?   @map("certificate_url")
  createdAt      DateTime  @default(now()) @map("created_at")

  profile  Profile      @relation(fields: [profileId], references: [id])
  training TrainingItem @relation(fields: [trainingId], references: [id])

  @@unique([profileId, trainingId])
  @@map("training_completions")
}

// ═══════════════════════════════════════════════════════════
// SPRINT 3 — Projects, Documents & Drawings
// ═══════════════════════════════════════════════════════════

model Project {
  id             String        @id @default(cuid())
  organisationId String        @map("organisation_id")
  officeId       String?       @map("office_id")
  code           String? // e.g. "ALC" for Abuja Life Camp
  name           String
  description    String?
  location       String?
  projectType    ProjectType   @default(HOTEL) @map("project_type")
  stage          ProjectStage  @default(BRIEF)
  status         ProjectStatus @default(ACTIVE)
  healthStatus   HealthStatus  @default(GREY) @map("health_status")
  currency       Currency? // Project-specific currency override (falls back to org default)
  clientBrand    String?       @map("client_brand") // e.g. "Accor", "Ibis Styles"

  // Key dates
  startDate        DateTime? @map("start_date")
  targetCompletion DateTime? @map("target_completion")

  // Current drawing issue
  currentIssueRef  String?   @map("current_issue_ref") // e.g. "C03"
  currentIssueDate DateTime? @map("current_issue_date")

  // PRD S5 — additional project fields
  siteAddress     String? @map("site_address")
  siteCity        String? @map("site_city")
  siteCountry     String? @map("site_country")
  buildingType    String? @map("building_type") // Hotel, Residential, Office, etc.
  jurisdiction    String? // England, Nigeria-Lagos, Nigeria-FCT, etc.
  feeBasis        String? @map("fee_basis") // Percentage, Lump Sum, Time Charge
  appointmentType String? @map("appointment_type") // Full Service, Partial, Novated
  contractValue   Float?  @map("contract_value")
  feeValue        Float?  @map("fee_value")
  grossFloorArea  Float?  @map("gross_floor_area") // m²
  numberOfUnits   Int?    @map("number_of_units")

  // PDR S5 — extended project setup fields
  siteRegion               String?   @map("site_region") // State/region
  sitePostcode             String?   @map("site_postcode")
  mapLatitude              Float?    @map("map_latitude")
  mapLongitude             Float?    @map("map_longitude")
  planningAuthority        String?   @map("planning_authority")
  buildingControlAuthority String?   @map("building_control_authority")
  developmentType          String?   @map("development_type") // NEW_BUILD, CONVERSION, REFURBISHMENT, EXTENSION, COMPLETION, FIT_OUT, MIXED
  clientType               String?   @map("client_type") // PRIVATE, DEVELOPER, CORPORATE, HOTEL_OWNER, HOTEL_OPERATOR, GOVERNMENT, INTERNAL
  operatorName             String?   @map("operator_name")
  operatorBrand            String?   @map("operator_brand")
  managementType           String?   @map("management_type") // FRANCHISE, MANAGEMENT_CONTRACT, OWNER_OPERATED, LEASE
  targetKeys               Int?      @map("target_keys")
  currentKeys              Int?      @map("current_keys")
  modelRoomRequired        Boolean?  @map("model_room_required")
  operatorContact          String?   @map("operator_contact")
  operatorStandardVersion  String?   @map("operator_standard_version")
  workStageFramework       String?   @map("work_stage_framework") // RIBA, NIGERIAN_CWA, INTERNATIONAL, DESIGN_BUILD, CUSTOM
  siteArea                 Float?    @map("site_area") // m²
  netInternalArea          Float?    @map("net_internal_area") // m²
  numberOfBlocks           Int?      @map("number_of_blocks")
  numberOfFloors           Int?      @map("number_of_floors")
  parkingSpaces            Int?      @map("parking_spaces")
  accessibleParking        Int?      @map("accessible_parking")
  fohArea                  Float?    @map("foh_area") // m²
  bohArea                  Float?    @map("boh_area") // m²
  budget                   Float?
  developmentStatus        String?   @map("development_status") // PRE_PLANNING, PLANNING, DESIGN, CONSTRUCTION, COMPLETED
  targetOpeningDate        DateTime? @map("target_opening_date")
  isBRPD                   Boolean   @default(false) @map("is_brpd")
  isCDM                    Boolean   @default(false) @map("is_cdm")
  complianceFrameworks     String?   @map("compliance_frameworks") // Comma-separated: BUILDING_REGS, PLANNING, FIRE_SAFETY, EDGE, BREEAM, LEED, OPERATOR_REQS

  // Sprint 2 — BUG-05: project-level SharePoint link
  sharepointUrl String? @map("sharepoint_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organisation Organisation @relation(fields: [organisationId], references: [id])
  office       Office?      @relation(fields: [officeId], references: [id])

  memberships          ProjectMembership[]
  tasks                Task[]
  documents            Document[]
  siteObservations     SiteObservation[]
  snags                Snag[]
  budgets              Budget[]
  variations           Variation[]
  purchaseOrders       PurchaseOrder[]
  tenders              Tender[]
  valuations           Valuation[]
  invoices             Invoice[]
  commercialRisks      CommercialRisk[]
  drawings             Drawing[]
  serviceRequests      ServiceRequest[]
  designReviews        DesignReview[]
  complianceRegisters  ComplianceRegister[]
  planningApplications PlanningApplication[]
  resourceAllocations  ResourceAllocation[]
  projectMilestones    ProjectMilestone[]
  projectUpdates       ProjectUpdate[]
  soaVersions          SOAVersion[]
  keyMetrics           KeyMetric[]
  feeQuotes            FeeQuote[]

  @@map("projects")
}

enum ProjectType {
  HOTEL
  RESIDENTIAL
  MIXED_USE
  RESORT
  REFURBISHMENT
  OFFICE_FIT_OUT
}

enum ProjectStage {
  BRIEF
  CONCEPT
  SPATIAL_COORDINATION
  WORKING_DRAWINGS
  CONSTRUCTION
  HANDOVER
  OPERATIONS
}

enum ProjectStatus {
  DRAFT
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum HealthStatus {
  GREEN
  AMBER
  RED
  GREY
}

model ProjectMembership {
  id          String      @id @default(cuid())
  projectId   String      @map("project_id")
  profileId   String      @map("profile_id")
  projectRole ProjectRole @default(TEAM_MEMBER) @map("project_role")
  assignedAt  DateTime    @default(now()) @map("assigned_at")
  removedAt   DateTime?   @map("removed_at")

  project Project @relation(fields: [projectId], references: [id])
  profile Profile @relation(fields: [profileId], references: [id])

  @@unique([projectId, profileId])
  @@map("project_memberships")
}

enum ProjectRole {
  PROJECT_LEAD
  PROJECT_ARCHITECT
  DESIGN_LEAD
  SENIOR_ARCHITECT
  ARCHITECT
  TEAM_MEMBER
  EXTERNAL_CONSULTANT
  CONTRACTOR
}

model Document {
  id              String         @id @default(cuid())
  projectId       String         @map("project_id")
  title           String
  documentType    DocumentType   @default(DRAWING) @map("document_type")
  discipline      String? // Architecture, Structural, MEP, etc.
  documentCode    String?        @map("document_code")
  securityLevel   SecurityLevel  @default(INTERNAL) @map("security_level")
  status          DocumentStatus @default(WORK_IN_PROGRESS)
  currentRevision String?        @map("current_revision")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project            @relation(fields: [projectId], references: [id])
  revisions DocumentRevision[]

  @@map("documents")
}

enum DocumentType {
  DRAWING
  SPECIFICATION
  SCHEDULE
  REPORT
  PHOTOGRAPH
  CORRESPONDENCE
  CERTIFICATE
  OTHER
}

enum SecurityLevel {
  INTERNAL
  CONSULTANT
  CONTRACTOR
  CLIENT_OPERATOR
  CONFIDENTIAL
  RESTRICTED
}

enum DocumentStatus {
  WORK_IN_PROGRESS
  SHARED_INTERNALLY
  INTERNAL_REVIEW
  APPROVED_FOR_ISSUE
  ISSUED
  SUPERSEDED
}

model DocumentRevision {
  id           String         @id @default(cuid())
  documentId   String         @map("document_id")
  revision     String // e.g. "P01", "C03"
  authorId     String         @map("author_id")
  fileUrl      String         @map("file_url")
  fileSize     Int?           @map("file_size")
  fileChecksum String?        @map("file_checksum")
  status       DocumentStatus @default(WORK_IN_PROGRESS)

  issuePurpose String?   @map("issue_purpose")
  issueDate    DateTime? @map("issue_date")
  supersededAt DateTime? @map("superseded_at")

  createdAt DateTime @default(now()) @map("created_at")

  document Document         @relation(fields: [documentId], references: [id])
  author   Profile          @relation("DocAuthor", fields: [authorId], references: [id])
  reviews  DocumentReview[]

  @@map("document_revisions")
}

model DocumentReview {
  id         String        @id @default(cuid())
  revisionId String        @map("revision_id")
  reviewerId String        @map("reviewer_id")
  outcome    ReviewOutcome @default(PENDING)
  comments   String?
  reviewedAt DateTime?     @map("reviewed_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  revision DocumentRevision @relation(fields: [revisionId], references: [id])
  reviewer Profile          @relation(fields: [reviewerId], references: [id])

  @@map("document_reviews")
}

enum ReviewOutcome {
  PENDING
  APPROVED
  CHANGES_REQUIRED
  REJECTED
}

// ═══════════════════════════════════════════════════════════
// SPRINT 4 — Tasks, Checklists & Review Workflow
// ═══════════════════════════════════════════════════════════

model Task {
  id           String  @id @default(cuid())
  projectId    String  @map("project_id")
  title        String
  description  String?
  instructions String? // Rich text task brief

  // Assignment
  ownerId    String? @map("owner_id")
  reviewerId String? @map("reviewer_id")

  // Classification
  stage      ProjectStage?
  discipline String?
  block      String? // Building block
  floor      String?
  priority   TaskPriority  @default(MEDIUM)
  status     TaskStatus    @default(NOT_STARTED)

  // Milestone link
  milestoneId String? @map("milestone_id")

  // Extended fields (Sprint 1 — BUG-07)
  deliverable  String? // Expected output / deliverable description
  sharepointUrl String? @map("sharepoint_url") // Link to SharePoint folder/doc

  // Dates
  dueDate        DateTime? @map("due_date")
  estimatedHours Float?    @map("estimated_hours")
  completedAt    DateTime? @map("completed_at")
  archivedAt     DateTime? @map("archived_at") // Soft-delete archive

  // Attachments — JSON array of {url, fileName, fileSize, contentType}
  attachments String? // JSON string

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project   Project           @relation(fields: [projectId], references: [id])
  owner     Profile?          @relation("TaskOwner", fields: [ownerId], references: [id])
  reviewer  Profile?          @relation("TaskReviewer", fields: [reviewerId], references: [id])
  milestone ProjectMilestone? @relation(fields: [milestoneId], references: [id])

  checklistItems TaskChecklistItem[]
  comments       TaskComment[]
  dependsOn      TaskDependency[] @relation("DependentTask")
  dependedOnBy   TaskDependency[] @relation("DependencyTarget")

  @@map("tasks")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  READY_FOR_REVIEW
  CHANGES_REQUIRED
  COMPLETED
}

model TaskChecklistItem {
  id          String    @id @default(cuid())
  taskId      String    @map("task_id")
  label       String
  mandatory   Boolean   @default(true)
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  sortOrder   Int       @default(0) @map("sort_order")

  // Sprint 1 — BUG-08: assignee + due date per checklist item
  assigneeId String?   @map("assignee_id")
  dueDate    DateTime? @map("due_date")

  task     Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee Profile? @relation("ChecklistAssignee", fields: [assigneeId], references: [id])

  @@map("task_checklist_items")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String   @map("task_id")
  authorId  String   @map("author_id")
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  task   Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author Profile @relation(fields: [authorId], references: [id])

  @@map("task_comments")
}

// Sprint 1 — BUG-07: Task dependencies
model TaskDependency {
  id           String             @id @default(cuid())
  taskId       String             @map("task_id")
  dependsOnId  String             @map("depends_on_id")
  type         TaskDependencyType @default(BLOCKS)
  createdAt    DateTime           @default(now()) @map("created_at")

  task      Task @relation("DependentTask", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOn Task @relation("DependencyTarget", fields: [dependsOnId], references: [id], onDelete: Cascade)

  @@unique([taskId, dependsOnId])
  @@map("task_dependencies")
}

enum TaskDependencyType {
  BLOCKS   // dependsOn must complete before task can start
  RELATED  // informational link, no blocking
}

