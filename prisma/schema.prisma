model ComplianceRegister {
  id              String                 @id @default(cuid())
  projectId       String                 @map("project_id")
  registerType    ComplianceRegisterType @map("register_type")
  name            String
  description     String?
  templateVersion String?                @map("template_version")
  overallStatus   ComplianceItemStatus   @default(NOT_STARTED) @map("overall_status")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  project Project          @relation(fields: [projectId], references: [id])
  items   ComplianceItem[]

  @@map("compliance_registers")
}

model ComplianceItem {
  id           String               @id @default(cuid())
  registerId   String               @map("register_id")
  section      String? // Group/category within the register
  requirement  String
  source       String? // Regulation/standard reference
  version      String? // Standard version
  ownerId      String?              @map("owner_id")
  dueDate      DateTime?            @map("due_date")
  status       ComplianceItemStatus @default(NOT_STARTED)
  evidence     String? // URL to evidence file
  evidenceDate DateTime?            @map("evidence_date")
  reviewerId   String?              @map("reviewer_id")
  reviewDate   DateTime?            @map("review_date")
  comments     String?
  sortOrder    Int                  @default(0) @map("sort_order")
  createdAt    DateTime             @default(now()) @map("created_at")
